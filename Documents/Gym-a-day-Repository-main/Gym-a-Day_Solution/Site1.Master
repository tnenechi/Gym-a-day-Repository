<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site1.master.cs" Inherits="Gym_a_Day_Solution.Site1" %>

<!DOCTYPE html>

<html>
<head runat="server">
    <title>Gym-a-Day</title>
     <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <%--<link rel="stylesheet" href="header_footer.css" />--%>
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css"
    />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">
 <style>

     * {
        margin: 0;
        padding: 0;
        font-family: Arial, Helvetica, sans-serif;
        --nav_length: 80px;
        --small_border_radius: 10px;
     }

    body {
        color: #fca311;
        background-image: none;
        background-color: #1e1e1e;
    }

    header {
        width: 100%;
    }

    nav {
        display: flex;
        justify-content: space-between;
        align-items: center;
        height: var(--nav_length);
        padding: 0 2em;
    }

    .nav_right {
        width: 60%;
   
    }

    .nav_right_section {
        width: 100%;
        display: flex;
        justify-content: space-evenly;
        align-items: center;
    }

    .divider {
        height: 30px;
        border-left: 2px solid;
    }

    .icon {
        margin: 0 0.05em;
        cursor: pointer;
    }

        .icon:hover {
            color: #fca311;
        }

    .customerNav, .adminNav{
        display: inline;
    }

    header .nav_right a:hover {
        background-color: #fca311;
        color: black;
    }

    header a, a, #contact{
        color: white;
        text-decoration: none;
        padding: 0.7em;
        border-radius: var(--small_border_radius);

    }

    header a:hover, #about-us a:hover {
        background-color: #fca311;
        transition: background-color linear 0.15s;
    }

    /* FOOTER*/

   
    hr {
        width: 90%;
        margin: 1em 0;
        border: 1px solid gray;
    }

    #big_footer {
        bottom: 0;
        text-align: center;
    }

    #small_footer {
        position: absolute;
        bottom: 0;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
    }

    #small_footer #buttons button {
        margin: 0.25em 0.5em;
        padding: 0.5em;
        background-color: #212121;
        color: #fff;
    }

    #small_footer #buttons button:hover {
        background-color: #fca311;
    }

    /*BIG SCREEN STYLES*/

 
         #small_screen_header{
             display: none;
         }

        #big_screen_header {
            display: flex;
            flex-direction: column;
        }

        #nav_right {
            width: 50%;
        }

        #hero_section {
            font-size: 2rem;
        }

        #small_footer {
            display: none;
        }

        #big_footer {
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
        }

        #footer_table thead th {
            text-align: left;
        }

        #footer_table thead th,
        #footer_table tbody td {
            padding: 0.25em 1em;
        }

        #footer_table td div {
            background-color: #212121;
            color: #fff;
            text-align: center;
            padding: 0.25em;
        }

        #footer_table td div:hover {
            background-color: #fca311;
        }



   </style>



<asp:ContentPlaceHolder ID="head" runat="server">
</asp:ContentPlaceHolder>

</head>

<body>



    <header id="big_screen_header">
      <nav>
        <div class="nav_left">
          <h1>Gym-a-day</h1>
    <asp:Literal ID="WelcomeMsg" runat="server"></asp:Literal>
        </div>

        <div class="nav_right">

            <%--User Nav--%>
            <section id="customerNav" class="nav_right_section" runat="server">
                <a href="Home.aspx">Home</a>
                <div class="divider"></div>
                  <a href="Bookings.aspx">Bookings</a>
                  <div class="divider"></div>
                  <a href="Clubs.aspx">Clubs</a>
                  <div class="divider"></div>
                  <a href="Catalog.aspx">Shop</a>
                  <div class="divider"></div>

                  <%--Login/Logout Nav--%>
                  <a runat="server" id="loginClient" href="Login.aspx">Sign in</a>
                    <a runat="server" id="logoutClient" onserverclick="Logout_click">Sign out</a>
            
                    <a href="Cart.aspx"><i class="icon fa-solid fa-cart-shopping"></i></a>
                  
                  <i class="icon fa fa-search"></i>

            </section>
          


            <%--Admin Nav--%>
             <section id="adminNav" class="nav_right_section" runat="server">
                <a href="Home.aspx">Home</a>
                <div class="divider"></div>
                  <a href="#">Show Bookings</a>
                  <div class="divider"></div>
                  <a href="ProductAddition.aspx">Products</a>
                  <div class="divider"></div>

                   <%--Login/Logout Nav--%>
                  <a runat="server" id="loginAdmin" href="Login.aspx">Sign in</a>
                    <a runat="server" id="logoutAdmin" onserverclick="Logout_click">Sign out</a>
            
                  <i class="icon fa-solid fa-cart-shopping"></i>
                  <i class="icon fa fa-search"></i>

            </section>

          
        </div>
      </nav>
    </header>


   <form id="form1" runat="server" enctype="multipart/form-data">
        <div>
            <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server">
            </asp:ContentPlaceHolder>
        </div>
    </form>


    <!-- Footer for screen sizes less than 768px -->
    <div id="small_footer">
      <hr />
      <h2>Download Our App</h2>
      <div id="buttons">
        <button>
          Download at the <br />
          App Store
        </button>
        <button>
          Get it on <br />
          Google Play
        </button>
        <button>
          Explore it on <br />
          App Gallery
        </button>
      </div>
      <hr />
    </div>

    <!-- Footer for screen sizes greater than 768px -->
 <div id="big_footer">
        <hr />
        <table id="footer_table">
          <thead>
            <tr>
              <th>Contact Us</th>
              <th>Account</th>
              <th>Company</th>
              <th>Follow Us</th>
            </tr>
          </thead>
          <tbody>

            <tr>
              <td id="contact">+27 11 432 4953</td>
              <td><a id="contact">My Account</a></td>
              <td id="contact">About Us</td>
              <td id="about-us">
                <a href="#"  class="fa fa-instagram"></a>
                <a href="#" class="fa fa-whatsapp"></a>
                <a href="#" class="fa fa-youtube"></a>
               
              </td>
            </tr>
            
          </tbody>
        </table>
        <hr />
      </div>
</body>
</html>
